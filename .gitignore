# Buzzly .gitignore
#
# Scoped to this project's decided stack: Next.js/TypeScript (apps/web), FastAPI/Python (apps/api),
# containers for PostgreSQL and Redis, macOS, VS Code.
#
# No application code exists yet, so this file is intentionally small. Extend it as Stage 0 lands
# real tooling - see docs/plans/active/0001-stage-0-foundation.md.
#
# Never ignore: lock files, .env.example files, docs/, AGENTS.md, PRODUCT.md, ARCHITECTURE.md,
# CONTRIBUTING.md, .github/ (instructions, skills, agents, hooks), or the tracked .vscode files.

# --- Secrets and local environment -------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem

# --- JavaScript / TypeScript dependencies and build output -------------------
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.eslintcache

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Test and coverage artifacts ---------------------------------------------
coverage/
htmlcov/
.coverage
.coverage.*
.pytest_cache/

# --- Tool caches -------------------------------------------------------------
.mypy_cache/
.ruff_cache/
.cache/

# --- Logs --------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Editor: keep shared config, ignore personal state -----------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
!.vscode/*.code-snippets
.idea/

# --- Local AI runtime state (never project knowledge) ------------------------
.ai-runtime/
