{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": ".github/hooks/session-start.sh",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": ".github/hooks/post-tool-use.sh",
        "timeout": 10
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": ".github/hooks/pre-compact.sh",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": ".github/hooks/stop.sh",
        "timeout": 10
      }
    ]
  }
}
