# Copy to .env and adjust. Never commit .env itself.
# These defaults match infra/docker-compose.yml for local development.

# Host port is 55432, not 5432: developer machines often already run Postgres there.
DATABASE_URL=postgresql+psycopg://buzzly:buzzly@localhost:55432/buzzly
REDIS_URL=redis://localhost:6379/0

# JSON array. Origins allowed to call this API from a browser.
CORS_ORIGINS=["http://localhost:3000"]
